# Cake Shop Ordering System - .gitignore

# Environment variables (contains real credentials)
.env

# Composer dependencies
/vendor/

# Uploaded files
/uploads/
/uploads/products/

# Logs
*.log
error_log

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.backup