# Database Configuration
DB_HOST=localhost
DB_NAME=cake_shop_db
DB_USER=root
DB_PASS=

# WebSocket Configuration
WS_HOST=localhost
WS_PORT=8080

# Application Settings
SITE_URL=http://localhost/cake-ordering-system
SITE_NAME="Cake Shop Ordering System"

# Security
SESSION_LIFETIME=3600
BCRYPT_ROUNDS=10

# File Uploads
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif

# Debug Mode
DEBUG_MODE=true